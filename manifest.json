{
  "manifest_version": 3,
  "name": "MyAEW Plus - Player UI & Speed Controller",
  "version": "1.0.0",
  "description": "Complete enhancement suite for MyAEW: cinematic theater mode, integrated top player bar, playback speed controller & smart buffer booster.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.myaew.com/*",
    "*://*.myaew.org/*",
    "*://*.myaew.net/*",
    "*://*.myaew.edu.au/*",
    "*://myaew.com/*",
    "*://myaew.org/*",
    "*://myaew.net/*",
    "*://myaew.edu.au/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.myaew.com/*",
        "*://*.myaew.org/*",
        "*://*.myaew.net/*",
        "*://*.myaew.edu.au/*",
        "*://myaew.com/*",
        "*://myaew.org/*",
        "*://myaew.net/*",
        "*://myaew.edu.au/*"
      ],
      "css": [
        "player.css",
        "speed-controller.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.myaew.com/*",
        "*://*.myaew.org/*",
        "*://*.myaew.net/*",
        "*://*.myaew.edu.au/*",
        "*://myaew.com/*",
        "*://myaew.org/*",
        "*://myaew.net/*",
        "*://myaew.edu.au/*"
      ],
      "js": [
        "player.js",
        "speed-controller.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}